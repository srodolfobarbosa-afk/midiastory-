{
  "rodolfo-cognitive-memory": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ../scripts/hooks/cognitive-hook.mjs SessionStart",
        "timeout": 10
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ../scripts/friday-triage-engine.mjs --hook-pre",
        "timeout": 5
      },
      {
        "type": "command",
        "command": "node ../scripts/hooks/cognitive-hook.mjs PreInvocation",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ../scripts/voice-narrator.mjs --hook-stop",
        "timeout": 120
      },
      {
        "type": "command",
        "command": "node ../scripts/hooks/cognitive-hook.mjs Stop",
        "timeout": 35
      }
    ]
  }
}
